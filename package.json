{
  "name": "musik-di-tengah-teror",
  "version": "1.0.0",
  "private": true,
  "description": "Animasi vertikal 1080x1920 @60fps - Musik di Tengah Teror (New Orleans 1919)",
  "scripts": {
    "start": "remotion studio",
    "typecheck": "tsc --noEmit",
    "render": "remotion render MusikDiTengahTeror out/musik-di-tengah-teror.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --image-format=jpeg --overwrite",
    "upgrade": "remotion upgrade"
  },
  "dependencies": {
    "@remotion/cli": "4.0.504",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.504"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
